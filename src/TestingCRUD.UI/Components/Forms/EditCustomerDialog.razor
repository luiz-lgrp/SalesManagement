@using TestingCRUD.Application.InputModels

<MudDialog>
    <MudForm @ref="form" OnValidSubmit="Submit">
        <MudDialogContent>
            <MudTextField @bind-Value="Model.Name"
                          Label="Nome"
                          Required="true"
                          For="@(() => Model.Name)" />
            <MudTextField @bind-Value="Model.Cpf"
                          Label="Cpf"
                          Mask="@(new PatternMask("000.000.000-00"))"
                          Required="true"
                          For="@(() => Model.Cpf)" />
            <MudTextField @bind-Value="Model.Email"
                          Label="Email"
                          Required="true"
                          For="@(() => Model.Email)" />
            <MudTextField @bind-Value="Model.Phone"
                          Label="Telefone"
                          Mask="@(new PatternMask("(00) 0 0000-0000"))"
                          Required="true"
                          For="@(() => Model.Phone)" />
        </MudDialogContent>
        <MudDialogActions>
            <MudButton Color="Color.Primary" Disabled="@(!form.IsValid)" ButtonType="ButtonType.Submit">
                Salvar
            </MudButton>
            <MudButton OnClick="MudDialog.Cancel">
                Cancelar
            </MudButton>
        </MudDialogActions>
    </MudForm>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CustomerInputModel Model { get; set; } = new();

    private MudForm form;

    private async Task Submit()
    {
        await form.Validate();

        if (!form.IsValid)
            return;

        MudDialog.Close(DialogResult.Ok(Model));
    }
}
